{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "astro/tsconfigs/strict",
    "include": [
      ".astro/types.d.ts",
      "**/*"
    ],
    "exclude": [
      "dist"
    ],
    "compilerOptions": {
      "types": ["node"],
      "jsx": "react-jsx",
      "jsxImportSource": "react"
    }
}